{
  "schema_version": 1,
  "name": "sherpa-onnx-subtitle-models",
  "description": "用于客户端 sherpa-onnx 的字幕模型清单。所有 enabled=true 的模型都需要配合 VAD 生成 segment 级字幕时间戳；token/word 级时间戳需要单独 smoke test 验证。",
  "runtime": {
    "engine": "sherpa-onnx",
    "runtime_should_bundle_with_app": true,
    "note": "不要让用户下载 runtime 二进制；App 按平台内置 sherpa-onnx runtime，用户只下载模型资源。"
  },
  "timestamp_policy": {
    "default_level": "segment",
    "default_source": "vad",
    "required_shared_asset_ids": [
      "funasr-fsmn-vad",
      "silero-vad"
    ],
    "subtitle_supported_rule": "supports_subtitle === true && timestamp.level in ['segment', 'token', 'word']",
    "token_timestamp_rule": "如果要逐字高亮、逐词删除、口癖精剪，需要模型返回 token/word timestamps，并在下载后 smoke test 验证。",
    "vad_subtitle_rule": "字幕 VAD 仅在自然停顿（min_silence≈0.35s）切段，max_speech≈30s 不短时长强切；短字幕由模型 token timestamps + 组句（默认 maxDuration=10s、pause=0.6s、句末符含 , 与空格）生成。"
  },
  "shared_assets": [
    {
      "id": "funasr-fsmn-vad",
      "name": "FunASR FSMN VAD",
      "type": "vad",
      "description": "FunASR FSMN 语音活动检测（中文优化）。字幕场景默认 VAD，纯 Rust 内置推理。",
      "required_for_subtitle": true,
      "files": [
        {
          "path": "model.onnx",
          "sha256": null
        },
        {
          "path": "model_quant.onnx",
          "sha256": null
        },
        {
          "path": "vad.mvn",
          "sha256": null
        },
        {
          "path": "vad.yaml",
          "sha256": null
        },
        {
          "path": "config.yaml",
          "sha256": null
        }
      ],
      "download_sources": [
        {
          "region": "global",
          "provider": "huggingface",
          "url": "https://huggingface.co/funasr/fsmn-vad-onnx/resolve/main/model.onnx"
        },
        {
          "region": "global",
          "provider": "huggingface",
          "url": "https://huggingface.co/funasr/fsmn-vad-onnx/resolve/main/model_quant.onnx"
        },
        {
          "region": "global",
          "provider": "huggingface",
          "url": "https://huggingface.co/funasr/fsmn-vad-onnx/resolve/main/vad.mvn"
        },
        {
          "region": "global",
          "provider": "huggingface",
          "url": "https://huggingface.co/funasr/fsmn-vad-onnx/resolve/main/vad.yaml"
        }
      ]
    },
