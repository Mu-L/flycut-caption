{
  "name": "@flycut/caption-react",
  "private": false,
  "version": "2.0.2",
  "type": "module",
  "description": "FlyCut Caption - AI-powered video subtitle editing React component with complete editing suite",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/caption-react.css",
    "dist/index.js.map",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles": "./dist/caption-react.css"
  },
  "keywords": [
    "react",
    "video",
    "subtitle",
    "caption",
    "editor",
    "ai",
    "asr",
    "whisper",
    "flycut",
    "video-editing",
    "speech-recognition"
  ],
  "author": "FlyCut Team",
  "license": "MIT",
  "homepage": "https://github.com/x007xyz/flycut-caption",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x007xyz/flycut-caption.git"
  },
  "bugs": {
    "url": "https://github.com/x007xyz/flycut-caption/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --mode library",
    "build:demo": "vite build --mode demo",
    "lint": "eslint .",
    "preview": "vite preview",
    "fetch:shared-assets": "bash scripts/fetch-shared-assets.sh",
    "fetch:subtitle-fonts": "bash scripts/fetch-subtitle-fonts.sh",
    "fetch:ffmpeg": "bash scripts/fetch-ffmpeg.sh",
    "tauri": "pnpm build:funasr-sidecar && pnpm fetch:ffmpeg && pnpm fetch:shared-assets && tauri",
    "build:funasr-sidecar": "cargo build --release --manifest-path src-tauri/sidecars/funasr-asr/Cargo.toml && mkdir -p src-tauri/binaries && install -m 755 src-tauri/sidecars/funasr-asr/target/release/funasr-asr src-tauri/binaries/funasr-asr",
    "tauri:dev": "pnpm build:funasr-sidecar && pnpm fetch:ffmpeg && pnpm fetch:shared-assets && tauri dev",
    "tauri:build": "pnpm build:funasr-sidecar && pnpm fetch:ffmpeg && pnpm fetch:shared-assets && pnpm fetch:subtitle-fonts && tauri build",
    "test": "node --test tests/**/*.test.mjs",
    "test:report": "node scripts/run-tests-report.mjs",
    "export:test-json": "node scripts/export-asr-test-json.mjs",
    "test:json": "ASR_TEST_SAVE_JSON=1 node --test tests/asr-families.integration.test.mjs tests/asr-demo.integration.test.mjs",
    "test:asr-demo": "node --test tests/asr-demo.integration.test.mjs",
    "test:asr-families": "node --test tests/asr-families.integration.test.mjs",
    "test:fsmn-vad": "node --test tests/fsmn-vad.integration.test.mjs",
    "test:sentence-grouping": "node --experimental-strip-types --test tests/sentence-grouping.test.mjs",
    "test:funasr-sidecar": "cargo test --manifest-path src-tauri/sidecars/funasr-asr/Cargo.toml -- --nocapture",
    "test:vad": "pnpm test:funasr-sidecar && pnpm test:fsmn-vad",
    "download:test-models": "node scripts/download-test-models.mjs",
    "test:smart-cut": "node --test tests/smart-cut-blank.test.mjs",
    "prepublishOnly": "npm run lint && npm run build:lib",
    "publish:npm": "npm publish"
  },
  "peerDependencies": {
    "i18next": ">=25.0.0",
    "i18next-browser-languagedetector": ">=8.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-i18next": ">=15.0.0",
    "zustand": ">=5.0.0"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@huggingface/transformers": "3.7.1",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@tauri-apps/api": "^2.11.1",
    "@webav/av-cliper": "^1.2.1",
    "@webav/av-recorder": "^1.2.1",
    "ahooks": "^3.9.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hotkeys-js": "^3.13.15",
    "i18next": "^25.5.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^0.542.0",
    "next-themes": "^0.4.6",
    "react-i18next": "^15.7.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@tailwindcss/vite": "^4.1.13",
    "@tauri-apps/cli": "^2.11.3",
    "@types/i18next": "^13.0.0",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vite-plugin-dts": "^4.5.4"
  }
}
